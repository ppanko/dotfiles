# Ignore machine-local and generated files by default.  Explicitly retain the
# portable configuration and its source assets.
*
!/.gitignore
!/.github/
!/.github/**
!/init.el
!/config.org
!/vterm-bashrc
!/lisp/
!/lisp/**
!/templates/
!/templates/**
!/test/
!/test/**
!/snippets/
!/snippets/**

*.elc
/custom.el
/secrets.el
